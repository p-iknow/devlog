<script>
  function initDesignSystem() {
    // Get computed styles
    function getTokenValue(tokenName: string): string {
      return getComputedStyle(document.documentElement)
        .getPropertyValue(tokenName)
        .trim();
    }

    // Update token values
    const surfaceEl = document.getElementById('value-surface');
    const backgroundEl = document.getElementById('value-background');
    const defaultEl = document.getElementById('value-default');
    const secondaryEl = document.getElementById('value-secondary');
    const tertiaryEl = document.getElementById('value-tertiary');
    const mutedEl = document.getElementById('value-muted');
    const subtleEl = document.getElementById('value-subtle');
    const accentEl = document.getElementById('value-accent');
    const accentHoverEl = document.getElementById('value-accent-hover');
    const accentLightEl = document.getElementById('value-accent-light');
    const accentLighterEl = document.getElementById('value-accent-lighter');
    const accentBgEl = document.getElementById('value-accent-bg');
    const accentBorderEl = document.getElementById('value-accent-border');

    if (surfaceEl) surfaceEl.textContent = getTokenValue('--color-surface');
    if (backgroundEl) backgroundEl.textContent = getTokenValue('--color-background');
    if (defaultEl) defaultEl.textContent = getTokenValue('--color-default');
    if (secondaryEl) secondaryEl.textContent = getTokenValue('--color-secondary');
    if (tertiaryEl) tertiaryEl.textContent = getTokenValue('--color-tertiary');
    if (mutedEl) mutedEl.textContent = getTokenValue('--color-muted');
    if (subtleEl) subtleEl.textContent = getTokenValue('--color-subtle');
    if (accentEl) accentEl.textContent = getTokenValue('--color-accent');
    if (accentHoverEl) accentHoverEl.textContent = getTokenValue('--color-accent-hover');
    if (accentLightEl) accentLightEl.textContent = getTokenValue('--color-accent-light');
    if (accentLighterEl) accentLighterEl.textContent = getTokenValue('--color-accent-lighter');
    if (accentBgEl) accentBgEl.textContent = getTokenValue('--color-accent-bg');
    if (accentBorderEl) accentBorderEl.textContent = getTokenValue('--color-accent-border');
  }

  document.addEventListener('DOMContentLoaded', initDesignSystem);
  document.addEventListener('astro:page-load', initDesignSystem);
</script>
