---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostList from "@/components/PostList.astro";
import { EnLocale } from "@/config/locale";
import { getPostUrl, extractOrderFromFilename } from "@/utils/posts";

const lang = EnLocale;
const isDev = import.meta.env.DEV;

export async function getStaticPaths() {
  const isDev = import.meta.env.DEV;

  const getPostLang = (post: { data: { lang?: string } }): string => {
    const postLang = post.data.lang;
    if (postLang && ["en", "ko"].includes(postLang)) {
      return postLang;
    }
    return "en";
  };

  const seriesCollection = await getCollection("series", (s) => getPostLang(s) === "en");
  const seriesPostsCollection = await getCollection("seriesPosts", (post) => {
    if (post.data.draft) return false;
    if (post.data["dev-only"] && !isDev) return false;
    return getPostLang(post) === "en";
  });

  const paths: Array<{
    params: { slug: string };
    props: { series: any; posts: any[] };
  }> = [];

  // Helper to extract series slug from id
  const getSeriesSlug = (id: string) => id.replace(/\/_index.*$/, "");

  // Helper to extract series slug from post id
  const stripLang = (id: string): string => {
    return id.replace(/\.(en|ko)$/, "");
  };
  const getPostSeriesSlug = (id: string) => stripLang(id).split("/")[0];

  // Group series posts by series
  const seriesPostsMap = new Map<string, typeof seriesPostsCollection>();
  seriesPostsCollection.forEach((post) => {
    const seriesSlug = getPostSeriesSlug(post.id);
    const posts = seriesPostsMap.get(seriesSlug) || [];
    posts.push(post);
    seriesPostsMap.set(seriesSlug, posts);
  });

  // Create series listing pages
  seriesCollection.forEach((series) => {
    const slug = getSeriesSlug(series.id);
    const posts = (seriesPostsMap.get(slug) || []).sort((a, b) => {
      const orderA = a.data.part ?? extractOrderFromFilename(a.id);
      const orderB = b.data.part ?? extractOrderFromFilename(b.id);
      return orderA - orderB;
    });

    paths.push({
      params: { slug },
      props: {
        series,
        posts,
      },
    });
  });

  return paths;
}

const { series, posts } = Astro.props;
---

<BaseLayout title={`${series.data.title} | Series`} description={series.data.description} lang={lang}>
  <div class="vertical-space"></div>
  <a href="/en/series" class="back-link">
    &larr; All Series
  </a>
  <div class="series-header">
    <h1 class="series-title">{series.data.title}</h1>
    <p class="series-description">{series.data.description}</p>
    <p class="series-count"><strong class="count-number">{posts.length}</strong> posts</p>
  </div>
  <hr class="divider" />
  <PostList
    posts={posts.filter((post: any) => !post.data.draft && (!post.data["dev-only"] || isDev))}
    getHref={(post: any) => getPostUrl(post, lang)}
  />
</BaseLayout>

<style>
  .vertical-space {
    height: 32px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 16px;
    font-size: 0.875rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .series-header {
    margin-bottom: 0;
  }

  .series-title {
    font-size: 2rem;
    font-weight: 700;
    margin: 0;
    color: var(--color-default);
  }

  .series-description {
    margin-top: 8px;
    margin-bottom: 0;
    color: var(--color-muted);
    font-size: 1rem;
  }

  .series-count {
    margin-top: 8px;
    margin-bottom: 0;
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  .count-number {
    color: var(--color-accent);
  }

  .divider {
    margin-top: 32px;
    margin-bottom: 28px;
    border: none;
    border-bottom: 1px solid var(--color-divider);
  }
</style>
