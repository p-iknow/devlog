---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="404 - Page Not Found">
  <div class="flex min-h-[50vh] flex-col items-center justify-center text-center">
    <h1 class="mb-4 text-6xl font-bold text-muted">404</h1>
    <p class="mb-8 text-xl text-muted">Page not found</p>
    <a
      href="/"
      class="rounded-lg bg-primary px-6 py-3 text-white transition-colors hover:bg-primary-hover"
    >
      Go Home
    </a>
  </div>
</BaseLayout>
