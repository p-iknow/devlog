---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostList from "@/components/post/PostList.astro";
import { format } from "date-fns";
import type { Locale } from "@/config/locale";
import { getPostUrl } from "@/utils/posts/url";
import type { PostWithLang, SeriesPostWithLang } from "@/utils/posts/types";

type PostEntry = PostWithLang | SeriesPostWithLang;

export async function getStaticPaths() {
  const { getPostsByLang, getSeriesPostsByLang } = await import("@/utils/posts/query");
  const { LOCALES } = await import("@/config/locale");

  const paths = [];

  for (const lang of LOCALES) {
    const posts = await getPostsByLang({ lang });
    const seriesPosts = await getSeriesPostsByLang({ lang });

    // 두 컬렉션을 합쳐서 날짜순 정렬
    const allPosts: PostEntry[] = [...posts, ...seriesPosts]
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

    paths.push({
      params: { lang },
      props: { allPosts },
    });
  }

  return paths;
}

const { lang } = Astro.params as { lang: Locale };
const { allPosts } = Astro.props;

const i18n = {
  ko: {
    title: "검색",
    description: "글 검색",
    postsLabel: "개의 글",
    placeholder: "제목이나 내용으로 검색...",
    noResults: "검색 결과가 없습니다.",
  },
  en: {
    title: "Search",
    description: "Search posts",
    postsLabel: " posts",
    placeholder: "Search posts by title or content...",
    noResults: "No posts found matching your search.",
  },
} as const;

const t = i18n[lang];

// Prepare posts data for client-side search
const searchablePosts = allPosts.map((post: any) => ({
  id: post.id,
  collection: post.collection,
  title: post.data.title,
  description: post.data.description || "",
  date: format(post.data.date, "yyyy-MM-dd"),
  tags: post.data.tags || [],
  body: post.body || "",
}));
---

<BaseLayout title={t.title} description={t.description} lang={lang}>
  <div class="search-container">
    <div class="search-header">
      <h1 class="mb-8 text-3xl font-bold">{t.title}</h1>
      <p class="search-count">
        <span id="post-count" class="text-accent-highlight">{searchablePosts.length}</span>{t.postsLabel}
      </p>
    </div>

    <div class="search-input-wrapper">
      <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" fill="currentColor">
        <path d="M505 442.7L405.3 343c-4.5-4.5-10.6-7-17-7H372c27.6-35.3 44-79.7 44-128C416 93.1 322.9 0 208 0S0 93.1 0 208s93.1 208 208 208c48.3 0 92.7-16.4 128-44v16.3c0 6.4 2.5 12.5 7 17l99.7 99.7c9.4 9.4 24.6 9.4 33.9 0l28.3-28.3c9.4-9.4 9.4-24.6.1-34zM208 336c-70.7 0-128-57.2-128-128 0-70.7 57.2-128 128-128 70.7 0 128 57.2 128 128 0 70.7-57.2 128-128 128z"/>
      </svg>
      <input
        type="text"
        id="search-input"
        placeholder={t.placeholder}
        autocomplete="off"
      />
    </div>

    <div id="search-results">
      <PostList posts={allPosts} getHref={(post) => getPostUrl(post, lang)} />
    </div>

    <div id="no-results" class="no-results" style="display: none;">
      {t.noResults}
    </div>
  </div>
</BaseLayout>

<script is:inline define:vars={{ searchablePosts }}>
  const posts = searchablePosts;
  const searchInput = document.getElementById('search-input');
  const noResults = document.getElementById('no-results');
  const postCount = document.getElementById('post-count');
  const postItems = document.querySelectorAll('.post-item');

  function filterPosts(query) {
    const lowerQuery = query.toLowerCase().trim();
    let visibleCount = 0;

    postItems.forEach((item) => {
      const postId = item.getAttribute('data-post-id');
      const postCollection = item.getAttribute('data-collection');
      const post = posts.find(p => p.id === postId && p.collection === postCollection);

      if (!post) return;

      const matchesTitle = post.title.toLowerCase().includes(lowerQuery);
      const matchesDescription = post.description.toLowerCase().includes(lowerQuery);
      const matchesBody = post.body.toLowerCase().includes(lowerQuery);
      const matchesTags = post.tags.some(tag => tag.toLowerCase().includes(lowerQuery));

      const isVisible = lowerQuery === '' || matchesTitle || matchesDescription || matchesBody || matchesTags;

      item.style.display = isVisible ? 'block' : 'none';

      if (isVisible) {
        visibleCount++;
      }
    });

    postCount.textContent = visibleCount;
    noResults.style.display = visibleCount === 0 ? 'block' : 'none';
  }

  searchInput.addEventListener('input', (e) => {
    filterPosts(e.target.value);
  });

  // Handle URL query parameter
  const urlParams = new URLSearchParams(window.location.search);
  const initialQuery = urlParams.get('q');
  if (initialQuery) {
    searchInput.value = initialQuery;
    filterPosts(initialQuery);
  }
</script>

<style>
  .search-container {
    margin-top: 0;
  }

  .search-header {
    margin-bottom: 0;
  }

  .search-count {
    font-size: 15px;
    color: var(--color-muted);
    margin-top: -24px;
    margin-bottom: 24px;
  }

  .search-input-wrapper {
    position: relative;
    margin-bottom: 28px;
  }

  .search-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    width: 20px;
    height: 20px;
    color: var(--color-muted);
  }

  #search-input {
    width: 100%;
    padding: 16px 16px 16px 48px;
    font-size: 16px;
    border: 1px solid var(--color-subtle);
    border-radius: 8px;
    background-color: var(--color-background);
    color: var(--color-default);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  #search-input:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-accent-bg);
  }

  #search-input::placeholder {
    color: var(--color-muted);
  }

  @media (max-width: 768px) {
    .search-container {
      padding: 0 10px;
    }
  }

  .no-results {
    text-align: center;
    padding: 48px 0;
    color: var(--color-muted);
    font-size: 18px;
  }
</style>
