---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HighlightedText from "@/components/HighlightedText.astro";
import type { Locale } from "@/config/locale";

export async function getStaticPaths() {
  const { getPostsByLang, getSeriesPostsByLang } = await import("@/utils/posts");
  const { LOCALES } = await import("@/config/locale");

  const paths = [];

  for (const lang of LOCALES) {
    const posts = await getPostsByLang({ lang });
    const seriesPosts = await getSeriesPostsByLang({ lang });

    // 태그별 포스트 수 계산 (posts + seriesPosts)
    const tagMap = new Map<string, number>();
    [...posts, ...seriesPosts].forEach((post) => {
      post.data.tags?.forEach((tag) => {
        tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
      });
    });

    const tags = Array.from(tagMap.entries())
      .sort((a, b) => b[1] - a[1])
      .map(([name, count]) => ({ name, count }));

    const totalPosts = posts.length + seriesPosts.length;

    paths.push({
      params: { lang },
      props: { tags, totalPosts },
    });
  }

  return paths;
}

const { lang } = Astro.params as { lang: Locale };
const { tags, totalPosts } = Astro.props;

const i18n = {
  ko: {
    title: "태그",
    description: "태그별 글 보기",
    summary: (tagsCount: number, postsCount: number) =>
      `${tagsCount}개의 태그, ${postsCount}개의 글`,
  },
  en: {
    title: "Tags",
    description: "Browse posts by tag",
    summary: (tagsCount: number, postsCount: number) =>
      `${tagsCount} tags across ${postsCount} posts`,
  },
} as const;

const t = i18n[lang];

// 태그 크기 계산을 위한 최대/최소값
const maxCount = Math.max(...tags.map((t: any) => t.count));
const minCount = Math.min(...tags.map((t: any) => t.count));

// 태그 크기 레벨 계산 (1-5)
const getTagLevel = (count: number) => {
  if (maxCount === minCount) return 3;
  const range = maxCount - minCount;
  const normalized = (count - minCount) / range;
  return Math.ceil(normalized * 4) + 1; // 1-5
};
---

<BaseLayout title={t.title} description={t.description} lang={lang}>
  <div class="p-0">
    <header class="mb-8">
      <h1 class="mb-8 text-3xl font-bold">{t.title}</h1>
      <HighlightedText
        text={t.summary(tags.length, totalPosts)}
        class="text-[15px] text-muted -mt-6 block"
      />
    </header>

    <div class="flex flex-wrap gap-3">
      {tags.map(({ name, count }: any, index: number) => {
        const level = getTagLevel(count);
        return (
          <a
            href={`/${lang}/tags/${name.toLowerCase()}`}
            class={`tag-item tag-level-${level}`}
            style={`--delay: ${index * 0.02}s`}
          >
            <span class="tag-name"># {name}</span>
            <span class="tag-count">{count}</span>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>

<style>
  .tag-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    animation: fadeInUp 0.5s ease-out var(--delay) both;
    position: relative;
    overflow: hidden;
  }

  .tag-item::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, transparent 100%);
    opacity: 0;
    transition: opacity 0.3s;
  }

  .tag-item:hover::before {
    opacity: 1;
  }

  .tag-item:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 8px 25px -5px rgba(66, 153, 225, 0.4);
  }

  .tag-name {
    position: relative;
    z-index: 1;
  }

  .tag-count {
    position: relative;
    z-index: 1;
    background: rgba(255, 255, 255, 0.2);
    padding: 2px 8px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
  }

  /* Tag levels - size and color variations */
  .tag-level-1 {
    font-size: 13px;
    padding: 8px 14px;
    background: linear-gradient(135deg, #64748b 0%, #94a3b8 100%);
    color: #ffffff;
  }
  .tag-level-1 .tag-count {
    background: rgba(255, 255, 255, 0.15);
  }

  .tag-level-2 {
    font-size: 14px;
    padding: 9px 16px;
    background: linear-gradient(135deg, #0ea5e9 0%, #38bdf8 100%);
    color: #ffffff;
  }

  .tag-level-3 {
    font-size: 15px;
    padding: 10px 18px;
    background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%);
    color: #ffffff;
  }

  .tag-level-4 {
    font-size: 16px;
    padding: 11px 20px;
    background: linear-gradient(135deg, #6366f1 0%, #818cf8 100%);
    color: #ffffff;
  }

  .tag-level-5 {
    font-size: 17px;
    padding: 12px 22px;
    background: linear-gradient(135deg, #8b5cf6 0%, #a78bfa 100%);
    color: #ffffff;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Dark mode adjustments */
  [data-theme="dark"] .tag-level-1 {
    background: linear-gradient(135deg, #475569 0%, #64748b 100%);
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .tag-level-1 {
      background: linear-gradient(135deg, #475569 0%, #64748b 100%);
    }
  }

  @media (max-width: 640px) {
    .tags-title {
      font-size: 32px;
    }

    .tags-cloud {
      gap: 8px;
    }

    .tag-item {
      padding: 8px 14px;
      font-size: 13px !important;
    }

    .tag-count {
      font-size: 11px;
      padding: 2px 6px;
    }
  }
</style>
