---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostList from "@/components/post/PostList.astro";
import HighlightedText from "@/components/post/HighlightedText.astro";
import type { Locale } from "@/config/locale";
import { getPostUrl } from "@/utils/posts/url";
import type { PostEntry } from "@/utils/posts/types";

export async function getStaticPaths() {
  const { getPostsByLang, getSeriesPostsByLang } = await import("@/utils/posts/query");
  const { LOCALES } = await import("@/config/locale");

  const paths: Array<{
    params: { lang: string; tag: string };
    props: { tag: string; posts: PostEntry[] };
  }> = [];

  for (const lang of LOCALES) {
    const posts = await getPostsByLang({ lang });
    const seriesPosts = await getSeriesPostsByLang({ lang });

    // 모든 태그 수집
    const tags = new Set<string>();
    posts.forEach((post) => {
      post.data.tags?.forEach((tag) => tags.add(tag.toLowerCase()));
    });
    seriesPosts.forEach((post) => {
      post.data.tags?.forEach((tag) => tags.add(tag.toLowerCase()));
    });

    Array.from(tags).forEach((tag) => {
      // posts에서 해당 태그를 가진 포스트들
      const matchingPosts = posts.filter((post) =>
        post.data.tags?.some((t) => t.toLowerCase() === tag)
      );
      // seriesPosts에서 해당 태그를 가진 포스트들
      const matchingSeriesPosts = seriesPosts.filter((post) =>
        post.data.tags?.some((t) => t.toLowerCase() === tag)
      );

      // 합쳐서 날짜순 정렬
      const allPosts = [...matchingPosts, ...matchingSeriesPosts]
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

      paths.push({
        params: { lang, tag },
        props: { tag, posts: allPosts },
      });
    });
  }

  return paths;
}

const { lang } = Astro.params as { lang: Locale };
const { tag, posts } = Astro.props;

const i18n = {
  ko: {
    titleSuffix: "태그",
    description: (tag: string) => `#${tag} 태그가 달린 글`,
    allTags: "모든 태그",
    postsCount: (count: number) => `${count}개의 글`,
  },
  en: {
    titleSuffix: "Tags",
    description: (tag: string) => `Posts tagged with #${tag}`,
    allTags: "All Tags",
    postsCount: (count: number) => `${count} posts`,
  },
} as const;

const t = i18n[lang];

// 포스트 타입에 따른 href 생성
const getPostHref = (post: PostEntry) => getPostUrl(post, lang);
---

<style>
  .back-link {
    transition: color 0.2s ease;
  }
  .back-link:hover {
    color: var(--color-accent);
  }
  .back-link .arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }
  .back-link:hover .arrow {
    transform: translateX(-4px);
  }
</style>

<BaseLayout title={`#${tag} | ${t.titleSuffix}`} description={t.description(tag)} lang={lang}>
  <div class="mb-8">
    <a
      href={`/${lang}/tags`}
      class="back-link mb-4 inline-flex items-center gap-1 text-sm text-muted hover:text-accent transition-colors"
    >
      <span class="arrow">&larr;</span> {t.allTags}
    </a>
    <h1 class="text-3xl font-bold"># {tag}</h1>
    <HighlightedText text={t.postsCount(posts.length)} class="mt-2 text-muted block" />
  </div>

  <PostList posts={posts} getHref={getPostHref} />
</BaseLayout>
