---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostList from "@/components/PostList.astro";
import Bio from "@/components/Bio.astro";
import CategorySidebar from "@/components/CategorySidebar.astro";
import { KoLocale } from "@/config/locale";
import type { CollectionEntry } from "astro:content";
import {
  getPostsByLang,
  getSeriesPostsByLang,
  filterPosts,
  filterSeriesPosts,
  getPostUrl,
  type PostWithLang,
  type SeriesPostWithLang,
  type PostEntry,
} from "@/utils/posts";

const lang = KoLocale;

// 한국어 포스트 (algorithm 카테고리 제외)
const posts = await getPostsByLang({
  lang,
  filter: (post) =>
    filterPosts(post) && post.data.category?.toLowerCase() !== "algorithm",
});

// 한국어 시리즈 포스트
const seriesPosts = await getSeriesPostsByLang({
  lang,
  filter: filterSeriesPosts,
});

// 두 Collection 합치기
type AnyPost = PostWithLang | SeriesPostWithLang;
const allPosts: AnyPost[] = [...posts, ...seriesPosts];

// 날짜순 정렬 (내림차순)
const sortedPosts = allPosts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// 카테고리 수집 및 카운트
const categoryCounts = new Map<string, number>();
allPosts.forEach((post) => {
  const category = post.data.category;
  if (category) {
    categoryCounts.set(category, (categoryCounts.get(category) || 0) + 1);
  }
});

// 카테고리를 카운트 기준 내림차순 정렬
const sortedCategories = Array.from(categoryCounts.entries())
  .sort((a, b) => b[1] - a[1]);

// href 생성 함수
const getHref = (post: PostEntry) => getPostUrl(post, lang);
---

<BaseLayout lang={lang}>
  <div class="vertical-space"></div>
  <Bio />
  <hr class="divider" />

  <div class="content-wrapper">
    <CategorySidebar categories={sortedCategories} lang={lang} />
    <div class="main-content">
      <PostList posts={sortedPosts} getHref={getHref} />
    </div>
  </div>
</BaseLayout>

<style>
  .vertical-space {
    height: 32px;
  }

  .divider {
    margin-top: 32px;
    margin-bottom: 28px;
    border: none;
    border-bottom: 1px solid var(--color-divider);
  }

  .content-wrapper {
    display: flex;
    gap: 48px;
  }

  .main-content {
    flex: 1;
    min-width: 0;
    max-width: 776px;
  }

  @media (max-width: 1024px) {
    .content-wrapper {
      display: block;
    }

    .main-content {
      max-width: none;
    }
  }
</style>
