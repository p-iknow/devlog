---
import { render } from "astro:content";
import PostLayout from "@/layouts/PostLayout.astro";
import { KoLocale } from "@/config/locale";
import { getPostSlug } from "@/utils/posts";

const lang = KoLocale;

export async function getStaticPaths() {
  const { getPostsByLang, getPostSlug } = await import("@/utils/posts");
  const { KoLocale } = await import("@/config/locale");

  const posts = await getPostsByLang({ lang: KoLocale });
  return posts.map((post) => ({
    params: { slug: getPostSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const slug = getPostSlug(post);
---

<PostLayout {...post.data} headings={headings} currentSlug={slug} lang={lang}>
  <Content />
</PostLayout>
