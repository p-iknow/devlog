---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostList from "@/components/PostList.astro";
import { KoLocale } from "@/config/locale";
import {
  getPostUrl,
  type PostWithLang,
  type SeriesPostWithLang,
} from "@/utils/posts";

const lang = KoLocale;

type PostEntry = PostWithLang | SeriesPostWithLang;

export async function getStaticPaths() {
  const { getPostsByLang, getSeriesPostsByLang } = await import("@/utils/posts");
  const { KoLocale } = await import("@/config/locale");

  const posts = await getPostsByLang({ lang: KoLocale });
  const seriesPosts = await getSeriesPostsByLang({ lang: KoLocale });

  // 모든 태그 수집
  const tags = new Set<string>();
  posts.forEach((post) => {
    post.data.tags?.forEach((tag) => tags.add(tag.toLowerCase()));
  });
  seriesPosts.forEach((post) => {
    post.data.tags?.forEach((tag) => tags.add(tag.toLowerCase()));
  });

  return Array.from(tags).map((tag) => {
    // posts에서 해당 태그를 가진 포스트들
    const matchingPosts = posts.filter((post) =>
      post.data.tags?.some((t) => t.toLowerCase() === tag)
    );
    // seriesPosts에서 해당 태그를 가진 포스트들
    const matchingSeriesPosts = seriesPosts.filter((post) =>
      post.data.tags?.some((t) => t.toLowerCase() === tag)
    );

    // 합쳐서 날짜순 정렬
    const allPosts = [...matchingPosts, ...matchingSeriesPosts]
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

    return {
      params: { tag },
      props: { tag, posts: allPosts },
    };
  });
}

const { tag, posts } = Astro.props;

// 포스트 타입에 따른 href 생성
const getPostHref = (post: PostEntry) => getPostUrl(post, lang);
---

<style>
  .back-link {
    transition: color 0.2s ease;
  }
  .back-link:hover {
    color: var(--color-accent);
  }
  .back-link .arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }
  .back-link:hover .arrow {
    transform: translateX(-4px);
  }
</style>

<BaseLayout title={`#${tag} | 태그`} description={`#${tag} 태그가 달린 글`} lang={lang}>
  <div class="mb-8">
    <a
      href="/ko/tags"
      class="back-link mb-4 inline-flex items-center gap-1 text-sm text-muted hover:text-accent transition-colors"
    >
      <span class="arrow">&larr;</span> 모든 태그
    </a>
    <h1 class="text-3xl font-bold"># {tag}</h1>
    <p class="mt-2 text-muted">{posts.length}개의 글</p>
  </div>

  <PostList posts={posts} getHref={getPostHref as any} />
</BaseLayout>
