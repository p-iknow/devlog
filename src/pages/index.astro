---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostList from "@/components/PostList.astro";
import Bio from "@/components/Bio.astro";
import { EnLocale } from "@/config/locale";
import type { CollectionEntry } from "astro:content";
import {
  getPostsByLang,
  getSeriesPostsByLang,
  filterPosts,
  filterSeriesPosts,
  getPostUrl,
  type PostWithLang,
  type SeriesPostWithLang,
} from "@/utils/posts";

const lang = EnLocale;

// 영어 포스트 (algorithm 카테고리 제외)
const posts = await getPostsByLang({
  lang,
  filter: (post) =>
    filterPosts(post) && post.data.category?.toLowerCase() !== "algorithm",
});

// 영어 시리즈 포스트
const seriesPosts = await getSeriesPostsByLang({
  lang,
  filter: filterSeriesPosts,
});

// 두 Collection 합치기
type AnyPost = PostWithLang | SeriesPostWithLang;
const allPosts: AnyPost[] = [...posts, ...seriesPosts];

// 날짜순 정렬 (내림차순)
const sortedPosts = allPosts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// 태그 수집 및 카운트
const tagCounts = new Map<string, number>();
allPosts.forEach((post) => {
  post.data.tags?.forEach((tag) => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  });
});

// 태그를 카운트 기준 내림차순 정렬
const sortedTags = Array.from(tagCounts.entries())
  .sort((a, b) => b[1] - a[1]);

// href 생성 함수
type PostEntry = PostWithLang | SeriesPostWithLang;
const getHref = (post: PostEntry) => getPostUrl(post, lang);
---

<BaseLayout lang={lang}>
  <div class="vertical-space"></div>
  <Bio />
  <hr class="divider" />

  <div class="content-wrapper">
    <div class="main-content">
      <PostList posts={sortedPosts} getHref={getHref} />
    </div>
    <aside class="sidebar">
      <div class="sidebar-section">
        <div class="sidebar-header">
          <svg class="sidebar-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" fill="currentColor">
            <path d="M0 80V229.5c0 17 6.7 33.3 18.7 45.3l176 176c25 25 65.5 25 90.5 0L418.7 317.3c25-25 25-65.5 0-90.5l-176-176c-12-12-28.3-18.7-45.3-18.7H48C21.5 32 0 53.5 0 80zm112 32a32 32 0 1 1 0 64 32 32 0 1 1 0-64z"/>
          </svg>
          <h3 class="sidebar-title">Tags</h3>
        </div>
        <div class="tag-cloud">
          {sortedTags.slice(0, 15).map(([tag, count], index) => (
            <a
              href={`/tags/${tag}`}
              class={`cloud-tag ${index < 3 ? 'popular' : ''}`}
              data-count={count}
            >
              <span class="tag-name"><span class="tag-hash">#</span>{tag}</span>
              <span class="tag-badge">{count}</span>
            </a>
          ))}
        </div>
        {sortedTags.length > 15 && (
          <a href="/tags" class="view-all-link">
            View all tags
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512" fill="currentColor">
              <path d="M310.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-192 192c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L242.7 256 73.4 86.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l192 192z"/>
            </svg>
          </a>
        )}
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .vertical-space {
    height: 32px;
  }

  .divider {
    margin-top: 32px;
    margin-bottom: 28px;
    border: none;
    border-bottom: 1px solid var(--color-divider);
  }

  .content-wrapper {
    display: flex;
    gap: 48px;
  }

  .main-content {
    flex: 1;
    min-width: 0;
    max-width: 776px;
  }

  .sidebar {
    width: 200px;
    flex-shrink: 0;
    position: sticky;
    top: 100px;
    align-self: flex-start;
    max-height: calc(100vh - 150px);
    overflow-y: auto;
  }

  .sidebar-section {
    background: var(--color-background);
    border-radius: 16px;
    padding: 20px;
    border: 1px solid var(--color-subtle);
  }

  .sidebar-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-subtle);
  }

  .sidebar-icon {
    width: 16px;
    height: 16px;
    color: var(--color-accent);
  }

  .sidebar-title {
    font-size: 13px;
    font-weight: 700;
    color: var(--color-secondary);
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin: 0;
  }

  .tag-cloud {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cloud-tag {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-secondary);
    background: transparent;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .cloud-tag:hover {
    color: var(--color-accent);
    background: var(--color-accent-bg);
  }

  .cloud-tag.popular {
    background: var(--color-accent-bg);
  }

  .cloud-tag.popular .tag-name {
    color: var(--color-accent);
    font-weight: 600;
  }

  .tag-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tag-hash {
    color: var(--color-muted);
    margin-right: 4px;
    font-weight: 400;
  }

  .cloud-tag:hover .tag-hash,
  .cloud-tag.popular .tag-hash {
    color: var(--color-accent);
  }

  .tag-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    font-size: 11px;
    font-weight: 600;
    color: var(--color-muted);
    background: var(--color-surface);
    border-radius: 10px;
  }

  .cloud-tag.popular .tag-badge {
    color: white;
    background: var(--color-accent);
  }

  .view-all-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    margin-top: 16px;
    padding: 10px;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-accent);
    background: var(--color-accent-bg);
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .view-all-link:hover {
    background: var(--color-accent);
    color: white;
  }

  .view-all-link svg {
    width: 10px;
    height: 10px;
    transition: transform 0.2s ease;
  }

  .view-all-link:hover svg {
    transform: translateX(2px);
  }

  @media (max-width: 1024px) {
    .content-wrapper {
      display: block;
    }

    .main-content {
      max-width: none;
    }

    .sidebar {
      display: none;
    }
  }
</style>
