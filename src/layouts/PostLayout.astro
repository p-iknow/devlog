---
import BaseLayout from "./BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { format } from "date-fns";
import Comments from "@/components/shared/Comments.astro";
import Bio from "@/components/shared/Bio.astro";
import PostNavigation from "@/components/post/PostNavigation.astro";
import { type Locale, defaultLocale } from "@/config/locale";
import { getLangPath } from "@/utils/locale";
import { getAllCombinedPostsByLang } from "@/utils/posts/query";
import { getPostSlug, getPostUrl } from "@/utils/posts/url";
import { stripLangFromId } from "@/utils/lang";

interface Props {
  title: string;
  description: string;
  date: Date;
  update?: Date;
  category?: string;
  tags?: string[];
  series?: string;
  img?: string;
  headings?: { depth: number; slug: string; text: string }[];
  currentSlug?: string;
  hidePostNavigation?: boolean;
  lang?: Locale;
}

const {
  title,
  description,
  date,
  tags = [],
  img,
  headings = [],
  currentSlug,
  hidePostNavigation = false,
  lang = defaultLocale,
} = Astro.props;

const langPath = getLangPath(lang);
const formattedDate = format(date, "yyyy-MM-dd");
const ogImage = img || siteConfig.ogImage;

// Get all posts (regular + series) for this language for prev/next navigation
const allPosts = await getAllCombinedPostsByLang({ lang });
const currentIndex = allPosts.findIndex((post) => {
  if (post.collection === "posts") {
    return getPostSlug(post) === currentSlug;
  } else {
    return stripLangFromId(post.id) === currentSlug;
  }
});
const prevPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;

const spaceToDash = (text: string) => text.replace(/\s+/g, '-');
---

<BaseLayout title={`${title} | ${siteConfig.title}`} description={description} ogImage={ogImage} lang={lang}>
  <article>
    <header class="mb-8">
      <h1 class="mb-4 text-[32px] md:text-[40px] font-bold leading-tight text-default">{title}</h1>
      <div class="flex flex-wrap items-center gap-2 mb-4 text-sm text-muted">
        <span class="text-default font-medium">@{siteConfig.author}</span>
        <span class="text-muted">·</span>
        <time datetime={date.toISOString()}>{formattedDate}</time>
      </div>
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-6">
          {tags.map((tag) => (
            <a href={`${langPath}/tags/${tag}`} class="post-tag">
              <span class="post-tag-hash">#</span>{spaceToDash(tag)}
            </a>
          ))}
        </div>
      )}
      <hr class="m-0 border-0 border-b border-divider" />
    </header>

    <div class="flex gap-12">
      <div class="flex-1 min-w-0 max-w-[776px]">
        <div class="prose">
          <slot />
        </div>
      </div>
      {headings.length > 0 && (
        <aside class="toc" id="toc" transition:animate="fade">
          <ul class="toc-list">
            {headings.filter(h => h.depth >= 2 && h.depth <= 4).map((heading) => (
              <li class={`toc-item toc-depth-${heading.depth}`}>
                <a href={`#${heading.slug}`} data-heading={heading.slug}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )}
    </div>

    <script>
      function initTocHighlight() {
        const toc = document.getElementById('toc');
        if (!toc) return;

        const tocLinks = toc.querySelectorAll('a[data-heading]');
        const headingElements = Array.from(tocLinks).map(link => {
          const id = link.getAttribute('data-heading');
          return id ? document.getElementById(id) : null;
        }).filter((h): h is HTMLElement => h !== null);

        if (headingElements.length === 0) return;

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const id = entry.target.id;
                tocLinks.forEach(link => {
                  link.classList.remove('active');
                  if (link.getAttribute('data-heading') === id) {
                    link.classList.add('active');
                    // Scroll TOC to show active item
                    const tocRect = toc.getBoundingClientRect();
                    const linkRect = link.getBoundingClientRect();
                    if (linkRect.top < tocRect.top || linkRect.bottom > tocRect.bottom) {
                      link.scrollIntoView({ block: 'center', behavior: 'smooth' });
                    }
                  }
                });
              }
            });
          },
          {
            rootMargin: '-80px 0px -70% 0px',
            threshold: 0
          }
        );

        headingElements.forEach((heading) => observer.observe(heading));
      }

      document.addEventListener('DOMContentLoaded', initTocHighlight);
      document.addEventListener('astro:page-load', initTocHighlight);
    </script>

    <script>
      function initAbbrTooltip() {
        const abbrs = document.querySelectorAll('.prose abbr[title]');

        abbrs.forEach(abbr => {
          abbr.setAttribute('tabindex', '0');

          abbr.addEventListener('click', (e) => {
            e.preventDefault();
            abbrs.forEach(a => a !== abbr && a.classList.remove('active'));
            abbr.classList.toggle('active');
          });
        });

        document.addEventListener('click', (e) => {
          const target = e.target as Element | null;
          if (!target?.closest('.prose abbr[title]')) {
            abbrs.forEach(abbr => abbr.classList.remove('active'));
          }
        });
      }

      document.addEventListener('DOMContentLoaded', initAbbrTooltip);
      document.addEventListener('astro:page-load', initAbbrTooltip);
    </script>

    {!hidePostNavigation && (prevPost || nextPost) && (
      <PostNavigation
        prevPost={prevPost}
        nextPost={nextPost}
        lang={lang}
        getHref={(post) => getPostUrl(post, lang)}
      />
    )}

    <div class="mt-12 p-6 bg-background border border-subtle rounded-xl max-w-[776px]">
      <Bio lang={lang} />
    </div>

    <hr class="mt-12 mb-0 border-0 border-b border-divider max-w-[776px]" />

    <footer class="mt-8 max-w-[776px]">
      <Comments />
    </footer>
  </article>
</BaseLayout>

<style>
  .toc {
    position: sticky;
    top: 100px;
    width: 200px;
    flex-shrink: 0;
    font-size: 14px;
    max-height: calc(100vh - 150px);
    overflow-y: auto;
    scrollbar-width: thin; /* Firefox - always show thin scrollbar */
    scrollbar-gutter: stable; /* Reserve space for scrollbar to prevent layout shift */
    scrollbar-color: transparent transparent; /* Initially transparent */
    padding-left: 24px;
    border-left: 1px solid var(--color-subtle);
    align-self: flex-start;
  }

  .toc::-webkit-scrollbar {
    width: 3px;
  }

  .toc::-webkit-scrollbar-track {
    background: transparent;
  }

  .toc::-webkit-scrollbar-thumb {
    background: transparent;
    border-radius: 10px;
    transition: background 0.2s ease;
  }

  .toc:hover {
    scrollbar-color: rgba(0, 0, 0, 0.2) transparent; /* Firefox - show on hover */
  }

  [data-theme="dark"] .toc:hover {
    scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
  }

  .toc:hover::-webkit-scrollbar-thumb {
    background: rgba(0, 0, 0, 0.2);
  }

  [data-theme="dark"] .toc:hover::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
  }

  .toc:hover::-webkit-scrollbar-thumb:hover {
    background: rgba(0, 0, 0, 0.3);
  }

  [data-theme="dark"] .toc:hover::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  @media (max-width: 1024px) {
    .toc {
      display: none;
    }
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-item {
    margin-bottom: 10px;
  }

  .toc-item a {
    color: var(--color-tertiary);
    text-decoration: none;
    transition: all 0.2s;
    line-height: 1.4;
    display: block;
    position: relative;
    margin-left: -25px;
    padding-left: 25px;
  }

  .toc-item a::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: transparent;
    transition: background 0.2s;
  }

  .toc-item a:hover {
    color: var(--color-accent-hover);
  }

  .toc-item a.active {
    color: var(--color-accent);
    font-weight: 600;
  }

  .toc-item a.active::before {
    background: var(--color-accent);
  }

  .toc-depth-2 {
    font-weight: 500;
  }

  .toc-depth-2 a {
    padding-left: 25px;
  }

  .toc-depth-3 {
    font-size: 13px;
  }

  .toc-depth-3 a {
    padding-left: 37px;
  }

  .toc-depth-4 {
    font-size: 12px;
  }

  .toc-depth-4 a {
    padding-left: 49px;
  }

  .post-bio {
    margin-top: 48px;
    padding: 24px;
    background-color: var(--color-background);
    border: 1px solid var(--color-subtle);
    border-radius: 12px;
    max-width: 776px;
  }

  .footer-divider {
    margin: 48px 0 0;
    border: none;
    border-bottom: 1px solid var(--color-divider);
    max-width: 776px;
  }

  .article-footer {
    margin-top: 32px;
    max-width: 776px;
  }
</style>
