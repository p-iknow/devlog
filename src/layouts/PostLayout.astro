---
import BaseLayout from "./BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { format } from "date-fns";
import Comments from "@/components/Comments.astro";

interface Props {
  title: string;
  description: string;
  date: Date;
  update?: Date;
  category?: string;
  tags?: string[];
  series?: string;
  img?: string;
}

const { title, description, date, update, category, tags = [], img } = Astro.props;

const formattedDate = format(date, "yyyy-MM-dd");
const formattedUpdate = update ? format(update, "yyyy-MM-dd") : null;
const ogImage = img || siteConfig.ogImage;
---

<BaseLayout title={`${title} | ${siteConfig.title}`} description={description} ogImage={ogImage}>
  <article>
    <header class="mb-8 border-b border-[var(--color-border)] pb-8">
      {category && (
        <a
          href={`/categories/${category.toLowerCase()}`}
          class="mb-2 inline-block text-sm text-[var(--color-primary)] hover:underline"
        >
          {category}
        </a>
      )}
      <h1 class="mb-4 text-3xl font-bold leading-tight md:text-4xl">{title}</h1>
      <p class="mb-4 text-lg text-[var(--color-muted)]">{description}</p>
      <div class="flex flex-wrap items-center gap-4 text-sm text-[var(--color-muted)]">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        {formattedUpdate && (
          <span>Updated: {formattedUpdate}</span>
        )}
      </div>
      {tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <a
              href={`/tags/${tag.toLowerCase()}`}
              class="rounded-full bg-[var(--color-border)] px-3 py-1 text-xs hover:bg-[var(--color-primary)] hover:text-white transition-colors"
            >
              #{tag}
            </a>
          ))}
        </div>
      )}
    </header>

    <div class="prose prose-lg max-w-none dark:prose-invert">
      <slot />
    </div>

    <footer class="mt-12 border-t border-[var(--color-border)] pt-8">
      <Comments />
    </footer>
  </article>
</BaseLayout>

<style is:global>
  /* Prose 스타일 오버라이드 */
  .prose {
    --tw-prose-body: var(--color-default);
    --tw-prose-headings: var(--color-default);
    --tw-prose-links: var(--color-primary);
    --tw-prose-bold: var(--color-default);
    --tw-prose-code: var(--color-default);
    --tw-prose-quotes: var(--color-muted);
    --tw-prose-quote-borders: var(--color-border);
    --tw-prose-hr: var(--color-border);
  }

  .prose h2 {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose h3 {
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .prose a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose code:not(pre code) {
    background-color: var(--color-border);
    padding: 0.2em 0.4em;
    border-radius: 0.25rem;
    font-size: 0.875em;
  }

  .prose pre {
    margin: 1.5rem 0;
  }

  .prose img {
    border-radius: 0.5rem;
  }

  .prose blockquote {
    border-left-width: 4px;
    border-left-color: var(--color-border);
    font-style: italic;
  }
</style>
