---
import type { Locale } from "@/config/locale";
import { getLangPath } from "@/config/locale";

interface Props {
  categories: [string, number][];
  lang: Locale;
}

const { categories, lang } = Astro.props;
const langPath = getLangPath(lang);
---

<aside class="sidebar">
  <div class="sidebar-section">
    <div class="sidebar-header">
      <svg class="sidebar-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" fill="currentColor">
        <path d="M64 480H448c35.3 0 64-28.7 64-64V160c0-35.3-28.7-64-64-64H288c-10.1 0-19.6-4.7-25.6-12.8L243.2 57.6C231.1 41.5 212.1 32 192 32H64C28.7 32 0 60.7 0 96V416c0 35.3 28.7 64 64 64z"/>
      </svg>
      <h3 class="sidebar-title">Categories</h3>
    </div>
    <div class="category-list">
      {categories.map(([category, count]) => (
        <a
          href={`${langPath}/categories/${category.toLowerCase()}`}
          class="category-item"
        >
          <span class="category-name">{category}</span>
          <span class="category-badge">{count}</span>
        </a>
      ))}
    </div>
  </div>
</aside>

<style>
  .sidebar {
    width: 200px;
    flex-shrink: 0;
    position: sticky;
    top: 100px;
    align-self: flex-start;
    max-height: calc(100vh - 150px);
    overflow-y: auto;
  }

  .sidebar-section {
    background: var(--color-background);
    border-radius: 16px;
    padding: 20px;
  }

  .sidebar-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
  }

  .sidebar-icon {
    width: 16px;
    height: 16px;
    color: var(--color-accent);
  }

  .sidebar-title {
    font-size: 13px;
    font-weight: 700;
    color: var(--color-secondary);
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin: 0;
  }

  .category-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .category-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-secondary);
    background: transparent;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .category-item:hover {
    color: var(--color-accent);
    background: var(--color-accent-bg);
  }

  .category-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .category-badge {
    font-size: 11px;
    font-weight: 600;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 1024px) {
    .sidebar {
      display: none;
    }
  }
</style>
