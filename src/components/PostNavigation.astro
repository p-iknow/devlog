---
import type { Locale } from "@/config/locale";

interface Props {
  prevPost: any | null;
  nextPost: any | null;
  lang: Locale;
  getHref: (post: any) => string;
}

const { prevPost, nextPost, lang, getHref } = Astro.props;

// Navigation labels
const navLabels = {
  en: { prev: '← Prev', next: 'Next →' },
  ko: { prev: '← 이전 글', next: '다음 글 →' },
};
const labels = navLabels[lang];
---

<nav class="post-navigation">
  {prevPost ? (
    <a href={getHref(prevPost)} class="nav-link nav-prev">
      <span class="nav-label">{labels.prev}</span>
      <span class="nav-title">{prevPost.data.title}</span>
    </a>
  ) : <div />}
  {nextPost ? (
    <a href={getHref(nextPost)} class="nav-link nav-next">
      <span class="nav-label">{labels.next}</span>
      <span class="nav-title">{nextPost.data.title}</span>
    </a>
  ) : <div />}
</nav>

<style>
  .post-navigation {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 48px;
    max-width: 776px;
  }

  .nav-link {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px;
    border: 1px solid var(--color-accent);
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s;
  }

  .nav-link:hover {
    background-color: var(--color-accent-bg);
  }

  .nav-prev {
    grid-column: 1;
  }

  .nav-next {
    grid-column: 2;
    text-align: right;
  }

  .nav-label {
    font-size: 14px;
    color: var(--color-muted);
  }

  .nav-title {
    font-size: 16px;
    font-weight: 500;
    color: var(--color-accent);
    line-height: 1.4;
  }
</style>
