---
import { siteConfig } from "@/config/site";
import { type Locale, defaultLocale } from "@/config/locale";
import { getLangPath, getAlternatePath } from "@/utils/locale";
import ThemeToggle from "@/components/ThemeToggle.astro";

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const langPath = getLangPath(lang);

const pathname = Astro.url.pathname;
const isActive = (path: string) => {
  const fullPath = `${langPath}${path}`;
  return pathname === fullPath || pathname === fullPath + "/";
};

const koUrl = getAlternatePath(pathname, "ko");
const enUrl = getAlternatePath(pathname, "en");
---

<header class="header">
  <div class="header-inner">
    <a href={`${langPath}/`} class="blog-title">
      <span class="blog-title-text">{siteConfig.title}</span>
      <span class="blog-subtitle-separator">/</span>
      <span class="blog-subtitle">{siteConfig.subtitle}</span>
      <img src="/p-stack-log.svg" alt={siteConfig.title} class="blog-title-logo" />
    </a>
    <nav class="menu">
      <a href={`${langPath}/`} class:list={["nav-item", { active: isActive("/") }]} title="Home">
        <span class="nav-text">Home</span>
        <span class="nav-icon-mobile">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512" fill="currentColor">
            <path d="M280.37 148.26L96 300.11V464a16 16 0 0 0 16 16l112.06-.29a16 16 0 0 0 15.92-16V368a16 16 0 0 1 16-16h64a16 16 0 0 1 16 16v95.64a16 16 0 0 0 16 16.05L464 480a16 16 0 0 0 16-16V300L295.67 148.26a12.19 12.19 0 0 0-15.3 0zM571.6 251.47L488 182.56V44.05a12 12 0 0 0-12-12h-56a12 12 0 0 0-12 12v72.61L318.47 43a48 48 0 0 0-61 0L4.34 251.47a12 12 0 0 0-1.6 16.9l25.5 31A12 12 0 0 0 45.15 301l235.22-193.74a12.19 12.19 0 0 1 15.3 0L530.9 301a12 12 0 0 0 16.9-1.6l25.5-31a12 12 0 0 0-1.7-16.93z"/>
          </svg>
        </span>
      </a>
      <a href={`${langPath}/tags`} class:list={["nav-item", { active: isActive("/tags") }]} title="Tags">
        <span class="nav-text">Tag</span>
        <span class="nav-icon-mobile">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" fill="currentColor">
            <path d="M440.667 182.109l7.143-40c1.313-7.355-4.342-14.109-11.813-14.109h-74.81l14.623-81.891C377.123 38.754 371.468 32 363.997 32h-40.632a12 12 0 0 0-11.813 9.891L296.175 128H197.54l14.623-81.891C213.477 38.754 207.822 32 200.35 32h-40.632a12 12 0 0 0-11.813 9.891L132.528 128H53.432a12 12 0 0 0-11.813 9.891l-7.143 40C33.163 185.246 38.818 192 46.289 192h74.81L98.242 320H19.146a12 12 0 0 0-11.813 9.891l-7.143 40C-1.123 377.246 4.532 384 12.003 384h74.81L72.19 465.891C70.877 473.246 76.532 480 84.003 480h40.632a12 12 0 0 0 11.813-9.891L151.826 384h98.634l-14.623 81.891C234.523 473.246 240.178 480 247.65 480h40.632a12 12 0 0 0 11.813-9.891L315.472 384h79.096a12 12 0 0 0 11.813-9.891l7.143-40c1.313-7.355-4.342-14.109-11.813-14.109h-74.81l22.857-128h79.096a12 12 0 0 0 11.813-9.891zM261.889 320h-98.634l22.857-128h98.634l-22.857 128z"/>
          </svg>
        </span>
      </a>
      <a href={`${langPath}/series`} class:list={["nav-item", { active: isActive("/series") }]} title="Series">
        <span class="nav-text">Series</span>
        <span class="nav-icon-mobile">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" fill="currentColor">
            <path d="M80 368H16a16 16 0 0 0-16 16v64a16 16 0 0 0 16 16h64a16 16 0 0 0 16-16v-64a16 16 0 0 0-16-16zm0-320H16A16 16 0 0 0 0 64v64a16 16 0 0 0 16 16h64a16 16 0 0 0 16-16V64a16 16 0 0 0-16-16zm0 160H16a16 16 0 0 0-16 16v64a16 16 0 0 0 16 16h64a16 16 0 0 0 16-16v-64a16 16 0 0 0-16-16zm416 176H176a16 16 0 0 0-16 16v32a16 16 0 0 0 16 16h320a16 16 0 0 0 16-16v-32a16 16 0 0 0-16-16zm0-320H176a16 16 0 0 0-16 16v32a16 16 0 0 0 16 16h320a16 16 0 0 0 16-16V80a16 16 0 0 0-16-16zm0 160H176a16 16 0 0 0-16 16v32a16 16 0 0 0 16 16h320a16 16 0 0 0 16-16v-32a16 16 0 0 0-16-16z"/>
          </svg>
        </span>
      </a>
      <a href={`${langPath}/search`} class:list={["nav-icon", { active: isActive("/search") }]} title="Search">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" fill="currentColor">
          <path d="M505 442.7L405.3 343c-4.5-4.5-10.6-7-17-7H372c27.6-35.3 44-79.7 44-128C416 93.1 322.9 0 208 0S0 93.1 0 208s93.1 208 208 208c48.3 0 92.7-16.4 128-44v16.3c0 6.4 2.5 12.5 7 17l99.7 99.7c9.4 9.4 24.6 9.4 33.9 0l28.3-28.3c9.4-9.4 9.4-24.6.1-34zM208 336c-70.7 0-128-57.2-128-128 0-70.7 57.2-128 128-128 70.7 0 128 57.2 128 128 0 70.7-57.2 128-128 128z"/>
        </svg>
      </a>
      <ThemeToggle />
      <div class="lang-select">
        <button class="lang-current" aria-haspopup="listbox" aria-expanded="false">
          <span class="lang-flag">{lang === "ko" ? "🇰🇷" : "🇺🇸"}</span>
          <span class="lang-text">{lang === "ko" ? "KO" : "EN"}</span>
          <svg class="lang-arrow" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="lang-dropdown" role="listbox">
          <a
            href={koUrl}
            class:list={["lang-option", { active: lang === "ko" }]}
            role="option"
            aria-selected={lang === "ko"}
          >
            <span class="lang-flag">🇰🇷</span>
            <span class="lang-text">한국어</span>
            {lang === "ko" && <span class="lang-check">✓</span>}
          </a>
          <a
            href={enUrl}
            class:list={["lang-option", { active: lang === "en" }]}
            role="option"
            aria-selected={lang === "en"}
          >
            <span class="lang-flag">🇺🇸</span>
            <span class="lang-text">English</span>
            {lang === "en" && <span class="lang-check">✓</span>}
          </a>
        </div>
      </div>
    </nav>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 999;
    padding: 6px 16px;
    background-color: var(--color-header-bg);
    box-shadow: 0 0 8px var(--color-header-shadow);
    backdrop-filter: blur(5px);
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1024px;
    margin: 0 auto;
    padding: 0 20px;
  }

  @media (max-width: 768px) {
    .header {
      padding: 6px 0;
    }
    .header-inner {
      padding: 0 15px;
    }
  }

  .blog-title {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .blog-title:hover {
    text-decoration: none;
  }

  .blog-title-text {
    letter-spacing: -0.5px;
    font-family: 'Source Code Pro', var(--font-mono);
    font-weight: 700;
    font-size: 22px;
    background: linear-gradient(135deg, var(--brand-gradient-start) 0%, var(--brand-gradient-end) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .blog-subtitle-separator {
    margin: 0 8px;
    font-size: 18px;
    font-weight: 300;
    color: var(--brand-gradient-start);
    opacity: 0.3;
  }

  .blog-subtitle {
    font-size: 13px;
    font-weight: 500;
    color: var(--brand-accent);
    letter-spacing: 0.3px;
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .blog-title:hover .blog-subtitle {
    opacity: 1;
  }

  .blog-title-logo {
    display: none;
    width: 44px;
    height: 44px;
  }

  @media (max-width: 768px) {
    .blog-title-text {
      display: none;
    }

    .blog-subtitle-separator {
      display: none;
    }

    .blog-subtitle {
      display: none;
    }

    .blog-title-logo {
      display: block;
    }
  }

  .menu {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .nav-item {
    display: flex;
    align-items: center;
    margin-right: 15px;
    color: var(--color-muted);
    transition: color 0.3s;
    font-size: 17px;
    font-weight: 500;
  }

  .nav-item:hover {
    color: var(--color-accent-hover);
    text-decoration: none;
  }

  .nav-item.active {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 8px;
    text-decoration-thickness: 2px;
  }

  .nav-text {
    display: inline;
  }

  .nav-icon-mobile {
    display: none;
  }

  .nav-icon-mobile svg {
    width: 20px;
    height: 20px;
  }

  @media (max-width: 768px) {
    .nav-text {
      display: none;
    }

    .nav-icon-mobile {
      display: flex;
      align-items: center;
    }
  }

  .nav-icon {
    display: flex;
    align-items: center;
    margin-right: 15px;
    color: var(--color-muted);
    transition: color 0.3s;
    position: relative;
  }

  .nav-icon:hover {
    color: var(--color-accent-hover);
    text-decoration: none;
  }

  .nav-icon.active {
    color: var(--color-accent);
  }

  .nav-icon.active::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 0;
    right: 0;
    height: 2px;
    background-color: var(--color-accent);
  }

  .nav-icon svg {
    width: 20px;
    height: 20px;
  }

  .nav-icon-last {
    margin-right: 0;
  }

  .lang-select {
    position: relative;
  }

  .lang-current {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 2px;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--color-muted);
    font-size: 15px;
    font-weight: 500;
    transition: color 0.3s ease;
  }

  .lang-current:hover {
    color: var(--color-accent-hover);
  }

  .lang-select.open .lang-current {
    color: var(--color-accent);
  }

  .lang-current .lang-flag {
    font-size: 17px;
    line-height: 1;
  }

  .lang-current .lang-text {
    font-family: inherit;
    letter-spacing: 0;
  }

  .lang-arrow {
    width: 12px;
    height: 12px;
    transition: transform 0.2s ease;
    opacity: 0.6;
  }

  .lang-select.open .lang-arrow {
    transform: rotate(180deg);
    opacity: 0.8;
  }

  .lang-dropdown {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    min-width: 140px;
    padding: 6px;
    background: var(--color-surface);
    border: 1px solid rgba(59, 130, 246, 0.15);
    border-radius: 12px;
    box-shadow:
      0 4px 20px rgba(0, 0, 0, 0.08),
      0 2px 8px rgba(0, 0, 0, 0.04);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px) scale(0.96);
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 100;
  }

  :global(.dark) .lang-dropdown {
    background: var(--color-surface);
    border-color: rgba(96, 165, 250, 0.2);
    box-shadow:
      0 4px 20px rgba(0, 0, 0, 0.3),
      0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .lang-select.open .lang-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  .lang-option {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 8px;
    color: var(--color-muted);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: all 0.15s ease;
  }

  .lang-option:hover {
    background: rgba(59, 130, 246, 0.08);
    color: var(--color-text);
    text-decoration: none;
  }

  .lang-option.active {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.12) 0%, rgba(14, 165, 233, 0.08) 100%);
    color: var(--chakra-blue-600);
  }

  :global(.dark) .lang-option.active {
    color: var(--chakra-blue-400);
  }

  .lang-option .lang-flag {
    font-size: 16px;
    line-height: 1;
  }

  .lang-option .lang-text {
    flex: 1;
  }

  .lang-check {
    color: var(--chakra-blue-600);
    font-weight: 600;
    font-size: 12px;
  }

  :global(.dark) .lang-check {
    color: var(--chakra-blue-400);
  }

  @media (max-width: 768px) {
    .lang-current .lang-text {
      display: none;
    }

    .lang-current {
      padding: 6px 8px;
    }

    .lang-dropdown {
      min-width: 130px;
    }
  }

  /* Mobile scroll hide */
  .header {
    transition: transform 0.3s ease;
  }

  @media (max-width: 768px) {
    .header.header-hidden {
      transform: translateY(-100%);
    }
  }
</style>

<script>
  /**
   * @fileoverview Header Event Handlers with Event Delegation Pattern
   *
   * @description
   * This script implements event delegation for Header interactions to work seamlessly
   * with Astro's View Transitions. Event listeners are registered once on document/window
   * and persist across all page navigations without re-initialization.
   *
   * @rationale Event Delegation Pattern
   * We chose event delegation over Astro's lifecycle events for:
   *
   * 1. **Single Event Listener Registration**
   *    - Listeners registered ONCE on document/window
   *    - No re-attachment needed on page transitions
   *    - Prevents memory leaks from duplicate listeners
   *
   * 2. **View Transitions Independence**
   *    - Works seamlessly with Astro View Transitions
   *    - No dependency on astro:page-load or astro:after-swap
   *    - Listeners persist across all navigations
   *
   * 3. **Performance Benefits**
   *    - Lower memory footprint (fewer listeners)
   *    - No re-initialization overhead
   *    - Automatic handling of dynamic elements
   *
   * @alternative Astro's Lifecycle Events Approach
   * Astro recommends lifecycle events for page-specific scripts:
   *
   * @example Using astro:page-load
   * ```javascript
   * document.addEventListener('astro:page-load', () => {
   *   // Re-attach event listeners after each navigation
   *   document.querySelector('.lang-current')
   *     ?.addEventListener('click', handler);
   * });
   * ```
   *
   * @example Using transition:persist
   * ```astro
   * <header transition:persist>
   *   <!-- DOM and listeners are preserved across navigations -->
   * </header>
   * ```
   *
   * @recommendation
   * Event delegation is preferable for global, static UI elements
   * that don't change between pages (Header, Footer, etc.)
   *
   * @see {@link https://docs.astro.build/en/guides/view-transitions/ Astro View Transitions}
   * @see {@link https://docs.astro.build/en/guides/view-transitions/#lifecycle-events Lifecycle Events}
   * @see {@link https://events-3bg.pages.dev/jotter/astro/scripts/ Event Delegation Pattern}
   */

  // Mobile header hide on scroll
  // Uses window-level event delegation - runs once, persists across all navigations
  let lastScrollY = window.scrollY;

  window.addEventListener('scroll', () => {
    const header = document.querySelector('.header');
    const isMobile = window.innerWidth <= 768;

    if (!isMobile) {
      header?.classList.remove('header-hidden');
      return;
    }

    const currentScrollY = window.scrollY;

    if (currentScrollY > lastScrollY && currentScrollY > 60) {
      header?.classList.add('header-hidden');
    } else {
      header?.classList.remove('header-hidden');
    }

    lastScrollY = currentScrollY;
  });

  // Language dropdown
  // Uses document-level event delegation with event.target.closest()
  // This pattern works with View Transitions without re-initialization
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const langButton = target.closest('.lang-current');
    const langSelect = target.closest('.lang-select');

    // Click on language button - toggle dropdown
    if (langButton) {
      e.stopPropagation();
      const container = langButton.closest('.lang-select');
      container?.classList.toggle('open');
      const isOpen = container?.classList.contains('open');
      langButton?.setAttribute('aria-expanded', String(isOpen));
      return;
    }

    // Click outside language dropdown - close all dropdowns
    if (!langSelect) {
      document.querySelectorAll('.lang-select').forEach(el => {
        el.classList.remove('open');
        el.querySelector('.lang-current')?.setAttribute('aria-expanded', 'false');
      });
    }
  });

  // Keyboard accessibility - close dropdown on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('.lang-select').forEach(el => {
        el.classList.remove('open');
        el.querySelector('.lang-current')?.setAttribute('aria-expanded', 'false');
      });
    }
  });
</script>
