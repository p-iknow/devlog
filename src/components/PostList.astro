---
import { format } from "date-fns";
import type { PostEntry } from "@/utils/posts";
import { stripLangFromId, getPostSlug } from "@/utils/posts";

interface Props {
  posts: PostEntry[];
  getHref?: (post: PostEntry) => string;
}

const { posts, getHref } = Astro.props;

// 기본 href 생성 함수 (모든 포스트는 /posts/{slug} 경로 사용)
const defaultGetHref = (post: PostEntry) => {
  if (post.collection === "seriesPosts") {
    return `/posts/${stripLangFromId(post.id)}`;
  }
  return `/posts/${getPostSlug(post)}`;
};
const resolveHref = getHref || defaultGetHref;

const spaceToDash = (text: string) => text.replace(/\s+/g, '-');

// 시리즈 포스트에서 시리즈 slug 추출
const getSeriesSlug = (post: PostEntry) => {
  if (post.collection === "seriesPosts") {
    return post.id.split("/")[0];
  }
  return null;
};

// 저자
const author = "@p-iknow";
---

<div class="post-list">
  {posts.map((post ) => {
    const { title, description, date, tags = [] } = post.data;
    const formattedDate = format(date, "yyyy-MM-dd");
    const seriesSlug = getSeriesSlug(post);

    return (
      <div class="post-item" data-post-id={post.id} data-collection={post.collection}>
        {seriesSlug && (
          <div class="series-badge-wrapper">
            <a href={`/series/${seriesSlug}`} class="series-badge">
              <span>🗂️</span><span>{seriesSlug}</span>
            </a>
          </div>
        )}
        <a href={resolveHref(post)} class="link-title post-title">
          {seriesSlug && 'part' in post.data && post.data.part ? `${post.data.part}. ${title}` : title}
        </a>
        <p class="post-excerpt">{description}</p>
        <span class="post-date">{formattedDate} · {author}</span>
        {tags.length > 0 && (
          <div class="post-tags">
            {tags.map((tag) => (
              <a href={`/tags/${tag}`} class="post-tag">
                <span class="post-tag-hash">#</span>{spaceToDash(tag)}
              </a>
            ))}
          </div>
        )}
      </div>
    );
  })}
</div>

<style>
  .post-item {
    margin-bottom: 48px;
  }

  .series-badge-wrapper {
    margin-bottom: 6px;
  }

  .post-excerpt {
    margin-top: 6px;
    margin-bottom: 0;
  }

  .post-date {
    display: block;
    font-size: 0.8125rem;
    color: var(--color-muted);
    margin-top: 10px;
    margin-bottom: 12px;
  }

  .series-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 8px;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-tag-text);
    background-color: var(--color-tag-bg);
    border-radius: 4px;
    text-decoration: none;
    transition: background-color 0.2s;
  }

  .series-badge:hover {
    background-color: var(--color-accent-bg);
    text-decoration: none;
  }

</style>
