---
import { format } from "date-fns";
import type { CollectionEntry } from "astro:content";

// 통합 포스트 타입 (posts 또는 seriesPosts)
type PostEntry = CollectionEntry<"posts"> | CollectionEntry<"seriesPosts">;

interface Props {
  posts: PostEntry[];
  getHref?: (post: PostEntry) => string;
}

const { posts, getHref } = Astro.props;

// 기본 href 생성 함수 (posts Collection 기준)
const defaultGetHref = (post: PostEntry) => `/posts/${post.id}`;
const resolveHref = getHref || defaultGetHref;

const spaceToDash = (text: string) => text.replace(/\s+/g, '-');
---

<div class="post-list">
  {posts.map((post, index) => {
    const { title, description, date, tags = [] } = post.data;
    const formattedDate = format(date, "yyyy-MM-dd");
    const isLast = index === posts.length - 1;

    return (
      <>
        <div class="post-item">
          <a href={resolveHref(post)} class="link-title post-title">{title}</a>
          <p class="post-date">{formattedDate}</p>
          <p class="post-excerpt">{description}</p>
          {tags.length > 0 && (
            <div class="post-tags">
              {tags.map((tag) => (
                <a href={`/tags/${tag}`} class="post-tag">
                  <span class="post-tag-hash">#</span>{spaceToDash(tag)}
                </a>
              ))}
            </div>
          )}
        </div>
        {!isLast && <hr class="post-divider" />}
      </>
    );
  })}
</div>
