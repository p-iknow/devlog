---
import { format } from "date-fns";
import type { CollectionEntry } from "astro:content";

interface Props {
  posts: CollectionEntry<"posts">[];
}

const { posts } = Astro.props;

const spaceToDash = (text: string) => text.replace(/\s+/g, '-');
---

<div class="post-list">
  {posts.map((post, index) => {
    const { title, description, date, tags = [] } = post.data;
    const formattedDate = format(date, "yyyy-MM-dd");
    const isLast = index === posts.length - 1;

    return (
      <>
        <div class="post-item">
          <h1 class="post-title">
            <a href={`/posts/${post.id}`}>{title}</a>
          </h1>
          <p class="post-date">{formattedDate}</p>
          <p class="post-excerpt">{description}</p>
          {tags.length > 0 && (
            <div class="post-tags">
              {tags.map((tag) => (
                <a href={`/tags?q=${tag}`} class="tag">
                  {spaceToDash(tag)}
                </a>
              ))}
            </div>
          )}
        </div>
        {!isLast && <hr class="divider" />}
      </>
    );
  })}
</div>

<style>
  .post-list {
    /* wrapper */
  }

  @media (max-width: 768px) {
    .post-list {
      padding: 0 10px;
    }
  }

  .post-item {
    position: relative;
    top: 0;
    transition: all 0.5s;
  }

  @media (max-width: 768px) {
    .post-item {
      padding: 0 5px;
    }
  }

  .post-title {
    margin-bottom: 24px;
    font-size: 33.6px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-default);
    word-break: break-all;
  }

  .post-title a {
    text-decoration: none;
    color: inherit;
    transition: all 0.2s;
  }

  .post-title a:hover {
    color: var(--color-accent-hover);
  }

  .post-date {
    margin-bottom: 16px;
    font-size: 14.4px;
    color: var(--color-tertiary);
  }

  .post-excerpt {
    margin-bottom: 32px;
    line-height: 1.7;
    font-size: 16px;
    color: var(--color-secondary);
    word-break: break-all;
  }

  .post-tags {
    margin-bottom: 16px;
    word-break: break-all;
  }

  .tag {
    display: inline-block;
    padding: 9.6px 11.2px;
    margin-right: 8px;
    margin-bottom: 8px;
    border-radius: 50px;
    background-color: var(--color-tag-bg);
    color: var(--color-tag-text);
    text-decoration: none;
    font-size: 14.4px;
    transition: all 0.2s;
  }

  .tag:hover {
    background-color: var(--color-accent-hover);
    color: #ffffff;
    text-decoration: none;
  }

  .divider {
    margin-top: 48px;
    margin-bottom: 32px;
    border: none;
    border-bottom: 1px solid var(--color-divider);
  }
</style>
