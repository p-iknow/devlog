---
---

<button
  id="theme-toggle"
  type="button"
  class="rounded-lg p-2 hover:bg-[var(--color-border)] transition-colors"
  aria-label="Toggle theme"
>
  <svg
    class="h-5 w-5 hidden dark:block"
    fill="currentColor"
    viewBox="0 0 20 20"
  >
    <path
      d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
      fill-rule="evenodd"
      clip-rule="evenodd"></path>
  </svg>
  <svg class="h-5 w-5 block dark:hidden" fill="currentColor" viewBox="0 0 20 20">
    <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"
    ></path>
  </svg>
</button>

<script>
  const toggle = document.getElementById("theme-toggle");

  function setTheme(theme: string) {
    document.documentElement.setAttribute("data-theme", theme);
    localStorage.setItem("theme", theme);
  }

  toggle?.addEventListener("click", () => {
    const current = document.documentElement.getAttribute("data-theme");
    const next = current === "dark" ? "light" : "dark";
    setTheme(next);
  });
</script>

<style>
  [data-theme="dark"] .dark\:block {
    display: block;
  }
  [data-theme="dark"] .dark\:hidden {
    display: none;
  }
  [data-theme="light"] .dark\:block,
  :not([data-theme]) .dark\:block {
    display: none;
  }
  [data-theme="light"] .dark\:hidden,
  :not([data-theme]) .dark\:hidden {
    display: block;
  }
</style>
