<div class="toggle-wrapper" id="theme-toggle">
  <div class="icon-rail">
    <!-- Moon icon (shown in dark mode) -->
    <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" fill="currentColor">
      <path d="M283.211 512c78.962 0 151.079-35.925 198.857-94.792 7.068-8.708-.639-21.43-11.562-19.35-124.203 23.654-238.262-71.576-238.262-196.954 0-72.222 38.662-138.635 101.498-174.394 9.686-5.512 7.25-20.197-3.756-22.23A258.156 258.156 0 0 0 283.211 0c-141.309 0-256 114.511-256 256 0 141.309 114.511 256 256 256z"/>
    </svg>
    <!-- Sun icon (shown in light mode) -->
    <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" fill="currentColor" stroke="currentColor" stroke-width="0">
      <path d="M256 160c-52.9 0-96 43.1-96 96s43.1 96 96 96 96-43.1 96-96-43.1-96-96-96zm246.4 80.5l-94.7-47.3 33.5-100.4c4.5-13.6-8.4-26.5-21.9-21.9l-100.4 33.5-47.4-94.8c-6.4-12.8-24.6-12.8-31 0l-47.3 94.7L92.7 70.8c-13.6-4.5-26.5 8.4-21.9 21.9l33.5 100.4-94.7 47.4c-12.8 6.4-12.8 24.6 0 31l94.7 47.3-33.5 100.5c-4.5 13.6 8.4 26.5 21.9 21.9l100.4-33.5 47.3 94.7c6.4 12.8 24.6 12.8 31 0l47.3-94.7 100.4 33.5c13.6 4.5 26.5-8.4 21.9-21.9l-33.5-100.4 94.7-47.3c13-6.5 13-24.7.2-31.1zm-155.9 106c-49.9 49.9-131.1 49.9-181 0-49.9-49.9-49.9-131.1 0-181 49.9-49.9 131.1-49.9 181 0 49.9 49.9 49.9 131.1 0 181z"/>
    </svg>
  </div>
</div>

<script>
  /**
   * @fileoverview Theme Toggle with Event Delegation
   *
   * @description
   * This component uses event delegation pattern to handle theme toggling.
   * Theme state is persisted in localStorage, and the listener is registered
   * once on document level to work seamlessly with View Transitions.
   *
   * @rationale Event Delegation Pattern
   *
   * **Why Event Delegation?**
   *
   * 1. **Single Event Listener**
   *    - Listener registered ONCE on document
   *    - No re-attachment needed on page transitions
   *    - Prevents duplicate listeners that cause double-toggle
   *
   * 2. **View Transitions Compatible**
   *    - Works independently of lifecycle events
   *    - No need for transition:persist directive
   *    - Consistent behavior across all navigations
   *
   * 3. **Theme State Persistence**
   *    - Theme saved in localStorage
   *    - Restored on page load via BaseLayout's theme script
   *    - No flash of wrong theme during transitions
   *
   * @rationale Why Not transition:persist?
   * While transition:persist is designed for this use case, it can cause issues:
   * - Scripts may still re-execute in some scenarios
   * - Can lead to duplicate event listeners
   * - Event delegation is more reliable and consistent
   *
   * @example Event Delegation Pattern
   * ```javascript
   * // Runs once, works forever
   * document.addEventListener('click', (e) => {
   *   const toggle = e.target.closest('#theme-toggle');
   *   if (toggle) {
   *     // handle theme change
   *   }
   * });
   * ```
   *
   * @see {@link https://docs.astro.build/en/guides/view-transitions/ Astro View Transitions}
   * @see {@link https://events-3bg.pages.dev/jotter/astro/scripts/ Event Delegation Pattern}
   */

  function setTheme(theme: string) {
    document.documentElement.setAttribute("data-theme", theme);
    localStorage.setItem("theme", theme);
  }

  // Event delegation - runs once, persists across all navigations
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const toggle = target.closest("#theme-toggle");

    if (toggle) {
      const current = document.documentElement.getAttribute("data-theme");
      const next = current === "dark" ? "light" : "dark";
      setTheme(next);
    }
  });
</script>

<style>
  .toggle-wrapper {
    width: 20px;
    height: 20px;
    margin-right: 15px;
    overflow: hidden;
    cursor: pointer;
  }

  .icon-rail {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    height: 40px;
    top: 0;
    transition: top 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .icon-rail svg {
    width: 20px;
    height: 20px;
    color: var(--color-muted);
    transition: opacity 0.3s ease-in-out, color 0.3s, transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .toggle-wrapper:hover svg {
    color: var(--color-accent-hover);
  }

  /* Light mode: show sun (rail at bottom), hide moon */
  .icon-moon {
    opacity: 0;
    transform: translateY(-4px);
  }
  .icon-sun {
    opacity: 1;
    transform: translateY(0);
  }
  .icon-rail {
    top: -20px;
  }

  /* Dark mode: show moon (rail at top), hide sun */
  :global([data-theme="dark"]) .icon-moon {
    opacity: 1;
    transform: translateY(0);
  }
  :global([data-theme="dark"]) .icon-sun {
    opacity: 0;
    transform: translateY(4px);
  }
  :global([data-theme="dark"]) .icon-rail {
    top: 0;
  }

  /* System preference dark mode */
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .icon-moon {
      opacity: 1;
      transform: translateY(0);
    }
    :global(:root:not([data-theme="light"])) .icon-sun {
      opacity: 0;
      transform: translateY(4px);
    }
    :global(:root:not([data-theme="light"])) .icon-rail {
      top: 0;
    }
  }
</style>
