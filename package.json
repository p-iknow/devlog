{
  "name": "p-iknow-s-dev-log",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "description": "p-iknow's dev-log",
  "author": "YoungChang Lee",
  "keywords": [
    "astro",
    "blog"
  ],
  "scripts": {
    "dev": "astro dev --port 3000",
    "build": "astro build",
    "preview": "astro preview --port 5000",
    "deploy": "wrangler deploy",
    "type-check": "astro check && tsc --noEmit",
    "format": "prettier --write 'src/**/*.{astro,css,html,json,md,mdx,js,jsx,ts,tsx}'",
    "lint": "eslint --fix 'src/**/*.{astro,js,jsx,ts,tsx}'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.3",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@expressive-code/plugin-line-numbers": "^0.41.7",
    "@r4ai/remark-callout": "^0.6.2",
    "@shikijs/transformers": "^4.0.2",
    "@tailwindcss/vite": "^4.2.3",
    "astro": "^6.1.8",
    "astro-expressive-code": "^0.41.7",
    "date-fns": "^4.1.0",
    "katex": "^0.16.45",
    "pretendard": "^1.3.9",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.2.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@types/node": "^25.6.0",
    "eslint": "^10.2.1",
    "eslint-plugin-astro": "^1.7.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.4",
    "wrangler": "^4.84.0"
  }
}
