{
  "name": "p-iknow-s-dev-log",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "description": "p-iknow's dev-log",
  "author": "YoungChang Lee",
  "keywords": [
    "astro",
    "blog"
  ],
  "scripts": {
    "dev": "astro dev --port 3000",
    "build": "astro build",
    "preview": "astro preview --port 5000",
    "type-check": "astro check && tsc --noEmit",
    "format": "prettier --write 'src/**/*.{astro,css,html,json,md,mdx,js,jsx,ts,tsx}'",
    "lint": "eslint --fix 'src/**/*.{astro,js,jsx,ts,tsx}'"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/rss": "^4.0.15",
    "@astrojs/sitemap": "^3.7.0",
    "@expressive-code/plugin-line-numbers": "^0.41.6",
    "@r4ai/remark-callout": "^0.6.2",
    "@shikijs/transformers": "^3.21.0",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^5.16.15",
    "astro-expressive-code": "^0.41.6",
    "date-fns": "^4.1.0",
    "katex": "^0.16.27",
    "pretendard": "^1.3.9",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@types/node": "^20.3.3",
    "eslint": "^9.39.2",
    "eslint-plugin-astro": "^1.5.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript-eslint": "^8.53.1"
  }
}
